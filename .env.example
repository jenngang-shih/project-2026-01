# Copy this file to .env and fill in real values. Never commit .env itself.

ANTHROPIC_API_KEY=your-key-here

# Azure OpenAI — backend for topic-1 (python -m src.cli --backend azure) and
# topic-2 (required — topic-2 has no other backend). AZURE_OPENAI_DEPLOYMENT
# and AZURE_OPENAI_EMBEDDING_DEPLOYMENT are the deployment names you chose in
# Azure AI Studio, not model names like "gpt-4o" — they can point at
# different underlying models (a chat model and an embedding model
# respectively) and topic-2's manual ingestion/retrieval needs the
# embedding one specifically.
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-deployment-name-here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name-here

# SERP data (topic-2): not needed — B4 specifies a static provided fixture
# (data/SERP_Data.json), not a live API call. Leave unset unless the system
# is later extended to fetch real SERP results.
SERP_API_KEY=

# Local LLM runtime endpoint (topic-3) — e.g. http://localhost:11434 for Ollama
LOCAL_LLM_ENDPOINT=
